# Подставьте свой домен. Файл обычно кладут в /etc/nginx/sites-available/leela
# и делают симлинк в sites-enabled.

server {
    listen 80;
    server_name YOUR_DOMAIN.ru www.YOUR_DOMAIN.ru;
    root /var/www/leela;
    index leela.html index.html;

    location /api/guide {
        proxy_pass http://127.0.0.1:8787/api/guide;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /leela.html;
    }
}
