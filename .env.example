# Ключ только на сервере. Никогда не вставляйте его в leela.html и не коммитьте.
DEEPSEEK_API_KEY=sk-...

# Модель проводника (дешевле с thinking: disabled на сервере)
DEEPSEEK_MODEL=deepseek-v4-flash

# Параметры генерации (опционально)
GUIDE_MAX_TOKENS=280
GUIDE_TEMPERATURE=0.35

# Сайт игры. На Beget укажите https://ваш-домен.ru
GUIDE_ORIGIN=*

HOST=127.0.0.1
PORT=8787
