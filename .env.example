# Ключ только на сервере. Никогда не вставляйте его в leela.html и не коммитьте.
DEEPSEEK_API_KEY=sk-...

# Модель проводника (дешевле с thinking: disabled на сервере)
DEEPSEEK_MODEL=deepseek-v4-flash

# Параметры генерации (опционально)
# Off-peak: UTC вне 01–04 и 06–10; с 23.08.2026 выходные (BJT) — весь день off-peak
GUIDE_MAX_TOKENS=320
GUIDE_MAX_TOKENS_PEAK=220
GUIDE_TEMPERATURE=0.45

# Сайт игры. На Beget укажите https://ваш-домен.ru
GUIDE_ORIGIN=*

HOST=127.0.0.1
PORT=8787
